[Unit]
Description=ZMydia personal video library
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/lib/zmydia/bin/zmydia-server serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
Environment="PATH=/usr/lib/zmydia/lib/mymedia/bin:/usr/local/bin:/usr/bin:/bin"
Environment="MYMEDIA_INSTALLATION_METHOD=debian"
Environment="MYMEDIA_DATA_DIR=%h/.local/share/zmydia"
Environment="MYMEDIA_CACHE_DIR=%h/.cache/zmydia"
Environment="MYMEDIA_FRONTEND_DIR=/usr/lib/zmydia/lib/mymedia/frontend"
Environment="MYMEDIA_EXTENSION_DIR=/usr/lib/zmydia/lib/mymedia/extension"
Environment="MYMEDIA_PORT=4173"
Environment="MYMEDIA_LOG_FORMAT=json"
EnvironmentFile=-%h/.config/zmydia/zmydia.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryHigh=1500M
MemoryMax=2500M
CPUQuota=200%

[Install]
WantedBy=default.target
